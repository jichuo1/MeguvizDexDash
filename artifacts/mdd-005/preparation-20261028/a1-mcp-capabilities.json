            "description": "Opt in to one structuredContent representation (content is empty). Query columns become\nnames and cells use null/string/number or [i|u|b|f, string]; SQL is omitted. Default false.",
            "type": "boolean"
          },
          "dataset_id": {
            "type": "string"
          },
          "limit": {
            "description": "Returned rows per statement, default 200; use a deterministic ORDER BY when paging.",
            "format": "uint",
            "maximum": 1000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_bytes": {
            "description": "Optional lower serialized result-byte budget; rows are never silently clipped.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "named_temp_queries": {
            "default": [],
            "description": "Lazy named SELECT definitions, retained in this dataset with the same lifetime as TEMP tables.",
