    {
      "name": "query",
      "title": null,
      "description": "Run a read-only SQL batch with exact typed cells, byte/row budgets and per-statement next_offset. Use stable ORDER BY when paging; SQL is re-executed against the current lazy session definitions on each page; CREATE definitions persist until DROP, replacement or dataset close. Running timeout/cancellation closes only this dataset. Use resources/list to discover the documentation.",
      "inputSchema": {
        "$defs": {
          "NamedTempQuery": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "sql": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "sql"
            ],
            "type": "object"
          }
        },
