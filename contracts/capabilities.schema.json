{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meguvizdexdash:capabilities:v1",
  "title": "MeguvizDexDash capabilities proposed contract",
  "x-contract-status": "proposed-not-implemented",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "engine_version",
    "build_id",
    "fact_schema_id",
    "relation_schema_hash",
    "profiles",
    "sql_dialects",
    "capabilities",
    "input_formats",
    "transports",
    "semantics",
    "effective_limits",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "mdd.capabilities.v1"
    },
    "product": {
      "const": "MeguvizDexDash"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_schema_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "admitted",
          "conformance_manifest_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "admitted": {
            "type": "boolean"
          },
          "conformance_manifest_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "admitted": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "conformance_manifest_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "sql_dialects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "revision",
          "features"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "available"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "input_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "versions",
          "available"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "available": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "result_encodings"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "result_encodings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "mcp",
                    "mcp-stdio"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "result_encodings": {
                  "const": [
                    "json"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "semantics": {
      "type": "object",
      "required": [
        "pagination_modes",
        "native_cancel_scope",
        "compat_cancel_closes_dataset"
      ],
      "properties": {
        "pagination_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "native_cancel_scope": {
          "const": "query"
        },
        "compat_cancel_closes_dataset": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "effective_limits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "scope",
          "enforcement"
        ],
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "description": "Decimal unsigned 64-bit integer. Runtime must also enforce <= 18446744073709551615."
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "enum": [
              "bytes",
              "count",
              "milliseconds",
              "threads"
            ]
          },
          "scope": {
            "enum": [
              "global",
              "worker",
              "session",
              "query"
            ]
          },
          "enforcement": {
            "enum": [
              "hard",
              "soft",
              "unavailable",
              "unbounded"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enforcement": {
                  "enum": [
                    "unavailable",
                    "unbounded"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "description": "Decimal unsigned 64-bit integer. Runtime must also enforce <= 18446744073709551615."
                }
              }
            }
          }
        ]
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
