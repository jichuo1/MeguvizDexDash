{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meguvizdexdash:benchmark-run:v1",
  "title": "MeguvizDexDash benchmark-run proposed contract",
  "x-contract-status": "proposed-not-implemented",
  "description": "One observed run, never a projection or aggregate fabricated from a single observation. A model projection belongs in a different artifact.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "run_id",
    "pair_id",
    "block_id",
    "round",
    "workload_id",
    "variant",
    "timestamp_utc",
    "engine",
    "harness",
    "inputs",
    "environment",
    "execution",
    "correctness",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "mdd.benchmark-run.v1"
    },
    "record_kind": {
      "const": "observed_run"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "B0",
        "B1"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": "object",
      "required": [
        "product",
        "version",
        "build_id",
        "binary_sha256",
        "source_commit",
        "profile",
        "sql_dialect"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "sql_dialect": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": [
        "revision",
        "manifest_sha256",
        "command_argv",
        "timing_boundary"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timing_boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "occurrence_id",
          "sha256",
          "bytes"
        ],
        "properties": {
          "occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "Decimal unsigned 64-bit integer. Runtime must also enforce <= 18446744073709551615."
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "machine_id",
        "os",
        "cpu",
        "memory_bytes",
        "total_cpu_budget",
        "engine_threads",
        "concurrent_jobs",
        "cache_state",
        "cache_control",
        "background_load",
        "artifact_sha256"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Decimal unsigned 64-bit integer. Runtime must also enforce <= 18446744073709551615."
        },
        "total_cpu_budget": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engine_threads": {
          "type": "integer",
          "minimum": 1
        },
        "concurrent_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "cache_state": {
          "enum": [
            "cold",
            "warm_os",
            "warm_engine",
            "warm_persistent",
            "mixed",
            "uncontrolled"
          ]
        },
        "cache_control": {
          "type": "string",
          "minLength": 1
        },
        "background_load": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "exit_code",
        "complete_output",
        "fallback_count",
        "contaminated",
        "contamination_reason",
        "wall_seconds"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timeout"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "complete_output": {
          "type": "boolean"
        },
        "fallback_count": {
          "type": "integer",
          "minimum": 0
        },
        "contaminated": {
          "type": "boolean"
        },
        "contamination_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "contaminated": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "contamination_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "correctness": {
      "type": "object",
      "required": [
        "scope_id",
        "input_complete",
        "facts_complete",
        "equivalent",
        "comparison_mode",
        "canonical_sha256",
        "certificate_sha256",
        "mismatch_count",
        "notes"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "input_complete": {
          "type": "boolean"
        },
        "facts_complete": {
          "type": "boolean"
        },
        "equivalent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "comparison_mode": {
          "enum": [
            "ordered",
            "bag",
            "structured",
            "expected_failure",
            "not_compared"
          ]
        },
        "canonical_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "certificate_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mismatch_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "equivalent": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "certificate_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mismatch_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "description": "Named metrics with explicit measurement scope; missing instruments are null plus a reason, never zero.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "scope",
          "method"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "enum": [
              "seconds",
              "milliseconds",
              "bytes",
              "count",
              "ratio"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "unavailable_reason"
              ],
              "properties": {
                "unavailable_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "unit": {
                  "enum": [
                    "bytes",
                    "count"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
